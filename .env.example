NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Configure Google OAuth credentials in Supabase, not in this file.
# Set the Supabase Site URL and allowed redirects to this application's origin.

# Phase 3: server-only email delivery. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional retry worker: a random secret of at least 32 characters.
STATUS_EMAIL_WORKER_SECRET=

# Phases 4 and 5: server-only HMAC key, at least 32 random characters.
PUBLIC_ACTION_SECRET=
# Optional: header containing one IP, overwritten by a trusted ingress proxy.
# Block direct origin access. Never use a header clients can supply unchanged.
# Leave blank for a shared global contact/report quota.
PUBLIC_ACTION_IP_HEADER=

# Phase 6: paid courses. Configure test-mode credentials first. Keep the API
# secret and webhook secret server-only; set the public key ID in Razorpay's
# Checkout client and use /api/webhooks/razorpay as the signed webhook URL.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
